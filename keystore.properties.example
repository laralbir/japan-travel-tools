# Plantilla de Configuración de Firma Release / Google Play Store
# Renombra o copia este archivo como keystore.properties (ignorado por Git)
# si deseas usar una clave de firma personalizada de Google Play Console.
# Si no existe, el sistema usará release.keystore generado por defecto.

storeFile=release.keystore
storePassword=japantraveltools
keyAlias=japantraveltools
keyPassword=japantraveltools

